# ── akame plugin ──
AKAME_MCP_URL=http://athena-memory:8000/mcp/
AKAME_API_KEY=
AKAME_USER_ID=akame

# Триггеры грануляции — события сессий
AKAME_GRANULATE_IDLE=true          # session.idle → грануляция
AKAME_GRANULATE_COMPACTED=true     # session.compacted → финальная грануляция
AKAME_GRANULATE_DIFF=false         # session.diff → инкрементальная грануляция

# Триггеры грануляции — события файлов
AKAME_GRANULATE_FILE=false         # file.edited → грануляция diff'ов
AKAME_GRANULATE_FILE_WATCHER=false # file.watcher.updated → грануляция

# Триггеры грануляции — события тулов
AKAME_GRANULATE_TOOL=true          # tool.execute.after → грануляция git-операций
AKAME_GRANULATE_TOOL_BEFORE=false  # tool.execute.before → pre-processing
AKAME_GRANULATE_COMMAND=false      # command.executed → грануляция

# Настройки
AKAME_COOLDOWN_MS=30000
AKAME_DEBOUNCE_MS=2000
AKAME_MAX_BATCH=20
AKAME_MAX_MESSAGES=50

# Обогащение гранул
AKAME_ENRICH_LINKS=true           # Пост-обработка: автосвязи между гранулами
AKAME_ENRICH_PROMPT=true          # Внедрение релевантных гранул в промпт

# ── Batch-грануляция ──
AKAME_BATCH_ENABLED=true          # Группировать диалоги в batch перед грануляцией (экономит LLM-запросы)
AKAME_BATCH_SIZE=5                # Максимальное количество диалогов в одном batch
AKAME_BATCH_MAX_AGE_MS=60000      # Максимальное время ожидания batch в мс (1 минута)

# ── Альтернатива: akame.json5 ──
# Вместо env-переменных можно использовать файл akame.json5
# Каскад: defaults → akame.json5 → env-переменные (env перезаписывает файл)
# Файл ищется в: ./akame.json5 или ~/.config/opencode/akame.json5
# См. docs/CONFIGURATION.md
